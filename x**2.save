#!/bin/bash
echo "Введи коэффициент a"
read a;
if [[ ! "$a" =~ ^-?[0-9]+$ ]];
then
echo "Недопустимый символ";
exit 1
fi

echo "Введи коэффициент b"
read b;
if [[ ! "$b" =~ ^-?[0-9]+$ ]];
then
echo "Недопустимый символ";
exit 1
fi

echo "Введи коэффициент c"
read c;
if [[ ! "$c" =~ ^-?[0-9]+$ ]];
then
echo "Недопустимый символ";
exit 1
fi

if [[ "$a" -eq 0 ]];
then
echo "Это не квадратное уравнение";
exit 1
fi

d=$((b*b-4*a*c));
echo "Дискриминант: $d";

if [[ "$d" -lt 0 ]];
then
echo "Корней нет";
exit 0
fi

s=0;
i=1;
while [[ $((i*i)) -le $d ]];
do
if [[ $((i*i)) -eq $d ]];
then
s=$i;
fi
i=$((i+1));
done

if [[ "$s" -eq 0 ]];
then
echo "Дискриминант не полный квадрат";
exit 1
fi

if [[ "$s" -eq 0 ]];
then
echo "Дискриминант не полный квадрат";
exit 1
fi
x1=$((0-b+s));
x1=$((x1/(2*a)));

x2=$((0-b-s));
x2=$((x2/(2*a)));

echo "x1 = $x1";
echo "x2 = $x2";
exit 0


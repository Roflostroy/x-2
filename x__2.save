#!/bin/bash

SCALE=4

if [ "$#" -eq 3 ];
then
    a="$1"
    b="$2"
    c="$3"
elif [ "$#" -eq 0 ];
then
    echo "Введи коэффициент a:"
    read a

    echo "Введи коэффициент b:"
    read b

    echo "Введи коэффициент c:"
    read c
else
    echo "Ошибка: Нужно передать ровно 3 аргумента или не передавать вовсе!"
    echo "Использование: $0 [a] [b] [c]"
    exit 1
fi

NUM_REGEX="^-?[0-9]*\.?[0-9]+$"

if [[ ! "$a" =~ $NUM_REGEX ]]; 
then
    echo "Ошибка: Коэффициент 'a' не является числом"; exit 1
fi

if [[ ! "$b" =~ $NUM_REGEX ]]; 
then
    echo "Ошибка: Коэффициент 'b' не является числом"; exit 1
fi

if [[ ! "$c" =~ $NUM_REGEX ]];
then
    echo "Ошибка: Коэффициент 'c' не является числом"; exit 1
fi

if [ "$(echo "$a == 0" | bc -l)" -eq 1 ];
then
    echo "Это не квадратное уравнение (a не должно быть равно 0)";
    exit 1
fi

d=$(echo "scale=$SCALE; $b * $b - 4 * $a * $c" | bc -l)
echo "Дискриминант: $d"

if [ "$(echo "$d < 0" | bc -l)" -eq 1 ]; then
    echo "Корней нет (дискриминант меньше нуля)";
    exit 0
fi

s=$(echo "scale=$SCALE; sqrt($d)" | bc -l)

if [ "$(echo "$d == 0" | bc -l)" -eq 1 ];
then
    x1=$(echo "scale=$SCALE; (0 - $b) / (2 * $a)" | bc -l)
    echo "Дискриминант равен 0. Один корень:"
    echo "x = $x1"
else
    x1=$(echo "scale=$SCALE; (0 - $b + $s) / (2 * $a)" | bc -l)
    x2=$(echo "scale=$SCALE; (0 - $b - $s) / (2 * $a)" | bc -l)

    echo "x1 = $x1"
    echo "x2 = $x2"
fi

exit 0

exit 0

#!/bin/bash

if [ "$#" -eq 3 ];
then
    a="$1"
    b="$2"
    c="$3"
elif [ "$#" -eq 0 ];
then
    echo "Введи коэффициент a"
    read a

    echo "Введи коэффициент b"
    read b

    echo "Введи коэффициент c"
    read c
else
    echo "Ошибка: Нужно передать ровно 3 аргумента или не передавать вовсе!"
    echo "Использование: $0 [a] [b] [c]"
    exit 1
fi

if [[ ! "$a" =~ ^-?[0-9]+$ ]];
then
    echo "Недопустимый символ";
    exit 1
fi

if [[ ! "$b" =~ ^-?[0-9]+$ ]];
then
    echo "Недопустимый символ";
    exit 1
fi

if [[ ! "$c" =~ ^-?[0-9]+$ ]];
then
    echo "Недопустимый символ";
    exit 1
fi

if [[ "$a" -eq 0 ]];
then
    echo "Это не квадратное уравнение (a не должно быть равно 0)";
    exit 1
fi

d=$((b*b-4*a*c));
echo "Дискриминант: $d";

if [[ "$d" -lt 0 ]];
then
    echo "Корней нет (дискриминант меньше нуля)";
    exit 0
fi

s=-1;
i=0;
while [[ $((i*i)) -le $d ]];
do
    if [[ $((i*i)) -eq $d ]];
then
        s=$i;
    fi
    i=$((i+1));
done

if [[ "$s" -eq -1 ]]; then
    echo "Ошибка: Дискриминант не является полным квадратом. Bash не умеет работать с дробными числами.";
    exit 1
fi

if [[ "$d" -eq 0 ]]; then
    x1=$(( (0 - b) / (2 * a) ));
    echo "Дискриминант равен 0. Один корень:";
    echo "x = $x1";
else
    x1=$(( (0 - b + s) / (2 * a) ));
    x2=$(( (0 - b - s) / (2 * a) ));

    echo "x1 = $x1";
    echo "x2 = $x2";
fi

exit 0
